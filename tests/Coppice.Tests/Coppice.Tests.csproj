<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Coppice.Core\Coppice.Core.csproj" />
    <ProjectReference Include="..\..\src\Coppice.Ports\Coppice.Ports.csproj" />
    <ProjectReference Include="..\..\src\Coppice.Adapters\Coppice.Adapters.csproj" />
    <ProjectReference Include="..\..\src\Coppice.Plugins.Net\Coppice.Plugins.Net.csproj" />
    <ProjectReference Include="..\..\src\Coppice.Plugins.Go\Coppice.Plugins.Go.csproj" />
    <ProjectReference Include="..\..\src\Coppice.Plugins.Rust\Coppice.Plugins.Rust.csproj" />
    <ProjectReference Include="..\..\src\Coppice.Cli\Coppice.Cli.csproj" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="FsCheck" Version="3.2.0" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Golden report files (T-017). They live in the source tree and are copied NEXT TO the test binary,
    because that is where the test looks: a golden file that only exists under bin/ is regenerated on
    every clean build and the golden comparison silently degrades into "compare against whatever the
    code does today".

    CopyToOutputDirectory is PreserveNewest rather than Always so an edited file is picked up, and
    the gitignore rule for bin/ keeps the copies out of the repository.
  -->
  <ItemGroup>
    <None Include="golden\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Recorded real tool outputs, same reason and same copy rule as the golden files. -->
    <None Include="recorded\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>


</Project>
