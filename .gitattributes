# Normalize line endings on checkin; the repo and .editorconfig require LF everywhere.
# eol=lf is explicit so a Windows checkout (core.autocrlf=true) cannot make dotnet format fail.
* text=auto eol=lf

*.cs text diff=csharp
*.csproj text
*.props text
*.slnx text
*.md text
*.json text
*.yml text

# The Apache-2.0 license text must stay byte-identical to the canonical copy.
LICENSE text eol=lf
