<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Coppice.Gui.ViewModels"
             x:Class="Coppice.Gui.Views.RootsView"
             x:DataType="vm:MainWindowViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="{StaticResource PagePadding}">

    <StackPanel Spacing="10">
      <TextBlock Classes="eyebrow" Text="REFERENCE · LOCATIONS" />
      <TextBlock Classes="pageTitle" Text="Where Coppice looks" />
      <TextBlock Classes="pageSubtitle"
                 Text="Every candidate root, how it was resolved, and whether it validated. A root that is not cleanable is reported with the concrete reason, never silently skipped." />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,18,0,12">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Classes="muted" Text="{Binding RootsStatus}" VerticalAlignment="Center" />
        <ProgressBar IsIndeterminate="True" Width="90" IsVisible="{Binding IsRootsLoading}"
                     AutomationProperties.Name="Reading machine locations" />
      </StackPanel>
      <Button Grid.Column="1" Classes="secondary"
              Command="{Binding RefreshRootsCommand}"
              AutomationProperties.Name="Re-read locations">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Data="{StaticResource IconRefresh}" Classes="icon sm" />
          <TextBlock Text="Re-read locations" />
        </StackPanel>
      </Button>
    </Grid>

    <Panel Grid.Row="2">
      <Border Classes="card" Padding="12" IsVisible="{Binding HasRoots}">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="160,2*,90,90,110,*" Margin="10,0,10,6">
            <TextBlock Classes="metricLabel" Text="LOCATION" />
            <TextBlock Grid.Column="1" Classes="metricLabel" Text="PATH" />
            <TextBlock Grid.Column="2" Classes="metricLabel" Text="VIA" />
            <TextBlock Grid.Column="3" Classes="metricLabel" Text="ROLE" />
            <TextBlock Grid.Column="4" Classes="metricLabel" Text="VALIDITY" />
            <TextBlock Grid.Column="5" Classes="metricLabel" Text="NOTE" />
          </Grid>
          <ListBox Grid.Row="1" Classes="rows" ItemsSource="{Binding Roots}"
                   AutomationProperties.Name="Resolved locations">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:RootRow">
                <Grid ColumnDefinitions="160,2*,90,90,110,*">
                  <TextBlock Text="{Binding LocationId}" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding Path}" Classes="path"
                             VerticalAlignment="Center" ToolTip.Tip="{Binding Path}" />
                  <TextBlock Grid.Column="2" Text="{Binding Via}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding Role}" VerticalAlignment="Center" />
                  <Border Grid.Column="4" Classes="pill" VerticalAlignment="Center"
                          HorizontalAlignment="Left"
                          Classes.success="{Binding Cleanable}"
                          Classes.danger="{Binding !Cleanable}">
                    <TextBlock Classes="pillText" Text="{Binding Validity}" />
                  </Border>
                  <TextBlock Grid.Column="5" Text="{Binding Problem}" Classes="muted"
                             VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Problem}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Classes="card" IsVisible="{Binding !HasRoots}">
        <StackPanel Spacing="14" HorizontalAlignment="Center" Margin="0,48">
          <Border Classes="iconTile" HorizontalAlignment="Center">
            <Path Data="{StaticResource IconMapPin}" Classes="icon lg"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Classes="sectionTitle" Text="No locations loaded yet" HorizontalAlignment="Center" />
          <TextBlock Classes="muted" TextAlignment="Center" MaxWidth="460"
                     Text="Coppice reads your environment, tool answers and per-OS defaults to find every registered cache. This check is read-only." />
          <Button Classes="primary" HorizontalAlignment="Center"
                  Command="{Binding RefreshRootsCommand}"
                  Content="Read locations" AutomationProperties.Name="Read machine locations" />
        </StackPanel>
      </Border>
    </Panel>

  </Grid>
</UserControl>
