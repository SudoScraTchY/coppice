<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Coppice.Gui.ViewModels"
             x:Class="Coppice.Gui.Views.HistoryView"
             x:DataType="vm:MainWindowViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="{StaticResource PagePadding}">

    <StackPanel Spacing="10">
      <TextBlock Classes="eyebrow" Text="REFERENCE · HISTORY" />
      <TextBlock Classes="pageTitle" Text="How the caches grew" />
      <TextBlock Classes="pageSubtitle"
                 Text="Every scan is stored. This page compares the most recent scans, so growth is measured rather than guessed — and the first scan is a baseline, not a sudden jump." />
    </StackPanel>

    <!-- ================================ CHART ================================ -->
    <Border Grid.Row="1" Classes="card" Margin="0,18,0,12" IsVisible="{Binding HasHistory}">
      <Grid RowDefinitions="Auto,Auto,Auto">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Classes="cardTitle" Text="{Binding HistorySummary}" />
            <TextBlock Classes="caption" Text="{Binding HistoryLatest}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="secondary"
                  Command="{Binding RefreshHistoryCommand}"
                  AutomationProperties.Name="Refresh history">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Data="{StaticResource IconRefresh}" Classes="icon sm" />
              <TextBlock Text="Refresh" />
            </StackPanel>
          </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
          <ItemsControl ItemsSource="{Binding HistoryPoints}"
                        AutomationProperties.Name="Cache size over time">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HistoryTrendPoint">
                <StackPanel Width="38" Spacing="4">
                  <Panel Height="120" Margin="0,2,0,0">
                    <Border Background="{DynamicResource AccentBrush}"
                            CornerRadius="{StaticResource RadiusSm}"
                            Width="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Height="{Binding ByteBarHeight}"
                            ToolTip.Tip="{Binding TotalLabel}" />
                    <Border Background="{DynamicResource InfoBrush}"
                            CornerRadius="{StaticResource RadiusSm}"
                            Width="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Height="{Binding ItemBarHeight}"
                            ToolTip.Tip="{Binding ItemLabel}" />
                  </Panel>
                  <TextBlock Classes="caption" Text="{Binding ShortDate}" TextAlignment="Center"
                             ToolTip.Tip="{Binding CapturedAt}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16" Margin="0,10,0,0">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Border Background="{DynamicResource AccentBrush}" Width="10" Height="10"
                    CornerRadius="{StaticResource RadiusSm}" VerticalAlignment="Center" />
            <TextBlock Classes="caption" Text="Total bytes" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Border Background="{DynamicResource InfoBrush}" Width="10" Height="10"
                    CornerRadius="{StaticResource RadiusSm}" VerticalAlignment="Center" />
            <TextBlock Classes="caption" Text="Item count" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Classes="caption" Text="Each series is scaled to the largest value in this window."
                     VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================================ LIST ================================ -->
    <Panel Grid.Row="2">
      <Border Classes="card" Padding="12" IsVisible="{Binding HasHistory}">
        <Grid RowDefinitions="Auto,Auto,*">
          <Grid ColumnDefinitions="*,Auto" Margin="10,0,10,8">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock Classes="muted"
                         Text="Newest first. Deltas compare each scan with the one before it."
                         VerticalAlignment="Center" />
              <ProgressBar IsIndeterminate="True" Width="90" IsVisible="{Binding IsHistoryLoading}"
                           AutomationProperties.Name="Reading the snapshot history" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1" ColumnDefinitions="160,110,110,190,*" Margin="10,0,10,6">
            <TextBlock Classes="metricLabel" Text="SCAN" />
            <TextBlock Grid.Column="1" Classes="metricLabel" Text="ITEMS" />
            <TextBlock Grid.Column="2" Classes="metricLabel" Text="BYTES" />
            <TextBlock Grid.Column="3" Classes="metricLabel" Text="CHANGE" />
            <TextBlock Grid.Column="4" Classes="metricLabel" Text="PER ECOSYSTEM" />
          </Grid>

          <ListBox Grid.Row="2" Classes="rows" ItemsSource="{Binding HistoryRows}"
                   AutomationProperties.Name="Recent snapshots">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:HistoryTrendPoint">
                <Grid ColumnDefinitions="160,110,110,190,*">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding CapturedAt}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SnapshotId}" Classes="caption"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>

                  <TextBlock Grid.Column="1" Text="{Binding ItemLabel}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding TotalLabel}" VerticalAlignment="Center" />

                  <TextBlock Grid.Column="3" Text="{Binding DeltaLabel}" VerticalAlignment="Center"
                             Classes.positive="{Binding IsGrowth}"
                             Classes.warningText="{Binding IsDecline}" />

                  <ItemsControl Grid.Column="4" ItemsSource="{Binding Ecosystems}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:HistoryEcosystemRow">
                        <Border Classes="pill" Margin="0,0,6,3">
                          <TextBlock Classes="pillText" Text="{Binding Label}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Classes="card" IsVisible="{Binding !HasHistory}">
        <StackPanel Spacing="14" HorizontalAlignment="Center" Margin="0,48">
          <Border Classes="iconTile" HorizontalAlignment="Center">
            <Path Data="{StaticResource IconClock}" Classes="icon lg"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Classes="sectionTitle" Text="No history to show yet" HorizontalAlignment="Center" />
          <TextBlock Classes="muted" TextAlignment="Center" MaxWidth="460"
                     Text="A scan stores a snapshot. The second scan is when growth becomes visible: this page will compare the two and name what grew, per ecosystem." />
          <ProgressBar IsIndeterminate="True" Width="180" HorizontalAlignment="Center"
                       IsVisible="{Binding IsHistoryLoading}"
                       AutomationProperties.Name="Reading the snapshot history" />
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
            <Button Classes="primary" Command="{Binding NavigateCommand}" CommandParameter="Scan"
                    Content="Go to scan" AutomationProperties.Name="Go to scan" />
            <Button Classes="secondary" Command="{Binding RefreshHistoryCommand}"
                    Content="Refresh" AutomationProperties.Name="Refresh history" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>

  </Grid>
</UserControl>
