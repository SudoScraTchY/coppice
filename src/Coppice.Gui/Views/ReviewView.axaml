<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Coppice.Gui.ViewModels"
             x:Class="Coppice.Gui.Views.ReviewView"
             x:DataType="vm:MainWindowViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="{StaticResource PagePadding}">

    <StackPanel Spacing="10">
      <TextBlock Classes="eyebrow" Text="STEP 3 OF 5" />
      <TextBlock Classes="pageTitle" Text="Review every proposed step" />
      <TextBlock Classes="pageSubtitle"
                 Text="Each step carries a reason. Uncheck anything you want to keep this time; nothing is moved until you confirm on the next step." />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,18,0,0">
      <TextBlock Classes="cardTitle" Text="{Binding PlanSummary}" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <ProgressBar IsIndeterminate="True" Width="90" IsVisible="{Binding IsPreviewBuilding}"
                     AutomationProperties.Name="Rebuilding the plan preview" />
        <Border Classes="pill" IsVisible="{Binding IsPreviewBuilding}">
          <TextBlock Classes="pillText" Text="Updating plan…" />
        </Border>
      </StackPanel>
    </Grid>

    <Border Grid.Row="2" Classes="card compact" Margin="0,14,0,12"
            IsVisible="{Binding HasSnapshot}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Path Data="{StaticResource IconListChecks}" Classes="icon" />
        <StackPanel Grid.Column="1" Margin="10,0,12,0" Spacing="2">
          <TextBlock Classes="label" Text="Retention policy" />
          <TextBlock Classes="muted" Text="{Binding PolicySummary}" />
        </StackPanel>
        <Button Grid.Column="2" Classes="secondary" Content="Change policy"
                VerticalAlignment="Center"
                AutomationProperties.Name="Change retention policy">
          <Button.Flyout>
            <Flyout>
              <Border Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="{StaticResource RadiusLg}"
                      Padding="16"
                      Width="460">
                <StackPanel Spacing="12">
                  <StackPanel Spacing="3">
                    <TextBlock Classes="cardTitle" Text="Retention policy" />
                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="A policy decides which versions are eligible. Referenced versions and versions with Unknown usage are never proposed, whatever the policy says." />
                  </StackPanel>

                  <ListBox Classes="policies"
                           MaxHeight="360"
                           ItemsSource="{Binding Policies}"
                           SelectedItem="{Binding SelectedPolicy, Mode=TwoWay}"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           AutomationProperties.Name="Retention policy choices">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:PolicyOption">
                        <Border Classes="policyCard">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Classes="muted" Text="{Binding Detail}" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>

                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsCustomPolicy}">
                    <TextBlock Text="Keep the newest" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding CustomKeepLatest, Mode=TwoWay}"
                                   Minimum="0" Maximum="1000" Increment="1" Width="140"
                                   AutomationProperties.Name="Custom keep count" />
                    <TextBlock Text="version(s)" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>

    <Panel Grid.Row="3">

      <Border Classes="card" Padding="12" IsVisible="{Binding HasPlan}">
        <Grid RowDefinitions="Auto,Auto,*">
          <Grid ColumnDefinitions="*,Auto" Margin="4,0,4,10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="ghost" Command="{Binding SelectAllStepsCommand}"
                      Content="Select all" AutomationProperties.Name="Select all steps" />
              <Button Classes="ghost" Command="{Binding ClearStepsCommand}"
                      Content="Clear" AutomationProperties.Name="Clear all steps" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Border Classes="pill accent">
                <TextBlock Classes="pillText"
                           Text="{Binding SelectedStepCount, StringFormat='{}{0} selected'}" />
              </Border>
              <Border Classes="pill">
                <TextBlock Classes="pillText" Text="{Binding SelectedStepBytes}" />
              </Border>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1" ColumnDefinitions="40,*,100,*" Margin="10,0,10,6">
            <TextBlock Grid.Column="1" Classes="metricLabel" Text="STEP" />
            <TextBlock Grid.Column="2" Classes="metricLabel" Text="SIZE" />
            <TextBlock Grid.Column="3" Classes="metricLabel" Text="WHY" />
          </Grid>

          <ListBox Grid.Row="2" Classes="rows" ItemsSource="{Binding PlanSteps}"
                   AutomationProperties.Name="Proposed steps">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PlanStepRow">
                <Grid ColumnDefinitions="40,*,100,*">
                  <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            AutomationProperties.Name="Include this step" />
                  <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding Size}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding Reason}" Classes="muted"
                             VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Reason}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Classes="card" IsVisible="{Binding !HasSnapshot}">
        <StackPanel Spacing="14" HorizontalAlignment="Center" Margin="0,48">
          <Border Classes="iconTile" HorizontalAlignment="Center">
            <Path Data="{StaticResource IconScan}" Classes="icon lg"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Classes="sectionTitle" Text="Scan first" HorizontalAlignment="Center" />
          <TextBlock Classes="muted" TextAlignment="Center" MaxWidth="420"
                     Text="There is no evidence to review yet. Run a scan; Coppice will compare the registered caches with your project roots." />
          <Button Classes="primary" HorizontalAlignment="Center"
                  Command="{Binding NavigateCommand}" CommandParameter="Scan"
                  Content="Go to scan" AutomationProperties.Name="Go to scan" />
        </StackPanel>
      </Border>

      <StackPanel IsVisible="{Binding HasSnapshot}">
        <Border Classes="card" IsVisible="{Binding !HasPlan}">
          <StackPanel Spacing="14" HorizontalAlignment="Center" Margin="0,32">
            <Border Classes="iconTile" HorizontalAlignment="Center">
              <Path Data="{StaticResource IconShieldCheck}" Classes="icon lg"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Classes="sectionTitle" Text="Nothing is proposed right now" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" TextAlignment="Center" MaxWidth="520" Text="{Binding PlanSummary}" />
            <TextBlock Classes="caption" TextAlignment="Center" MaxWidth="520"
                       Text="Try a different retention policy above, rescan for fresher evidence, or open Evidence to see why each item was kept." />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
              <Button Classes="secondary"
                      Command="{Binding NavigateCommand}" CommandParameter="Items"
                      Content="Open evidence" AutomationProperties.Name="Open evidence" />
              <Button Classes="primary"
                      Command="{Binding NavigateCommand}" CommandParameter="Scan"
                      Content="Scan again" AutomationProperties.Name="Scan again" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>

    </Panel>

    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,16,0,0" IsVisible="{Binding HasPlan}">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Classes="muted" VerticalAlignment="Center"
                   Text="Selected steps will be moved to quarantine, not deleted." />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
        <TextBlock Classes="caption" VerticalAlignment="Center"
                   Text="{Binding SelectedStepBytes, StringFormat='{}Reclaim {0}'}" />
        <Button Classes="primary"
                Command="{Binding ContinueToApplyCommand}"
                AutomationProperties.Name="Continue to apply">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Continue to apply" Foreground="{DynamicResource TextOnAccentBrush}" />
            <Path Data="{StaticResource IconArrowRight}" Classes="icon sm"
                  Stroke="{DynamicResource TextOnAccentBrush}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

  </Grid>
</UserControl>
