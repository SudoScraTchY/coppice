<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Coppice.Gui.ViewModels"
        xmlns:controls="using:Coppice.Gui.Controls"
        xmlns:views="using:Coppice.Gui.Views"
        x:Class="Coppice.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Coppice — harvest what regrows"
        Width="1280" Height="860"
        MinWidth="1040" MinHeight="700"
        Background="{DynamicResource AppBackgroundBrush}">

  <Window.KeyBindings>
    <KeyBinding Gesture="F1" Command="{Binding ToggleHelpCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding CloseHelpCommand}" />
    <KeyBinding Gesture="Ctrl+1" Command="{Binding NavigateCommand}" CommandParameter="Setup" />
    <KeyBinding Gesture="Ctrl+2" Command="{Binding NavigateCommand}" CommandParameter="Scan" />
    <KeyBinding Gesture="Ctrl+3" Command="{Binding NavigateCommand}" CommandParameter="Review" />
    <KeyBinding Gesture="Ctrl+4" Command="{Binding NavigateCommand}" CommandParameter="Apply" />
    <KeyBinding Gesture="Ctrl+5" Command="{Binding NavigateCommand}" CommandParameter="Quarantine" />
    <KeyBinding Gesture="Cmd+1" Command="{Binding NavigateCommand}" CommandParameter="Setup" />
    <KeyBinding Gesture="Cmd+2" Command="{Binding NavigateCommand}" CommandParameter="Scan" />
    <KeyBinding Gesture="Cmd+3" Command="{Binding NavigateCommand}" CommandParameter="Review" />
    <KeyBinding Gesture="Cmd+4" Command="{Binding NavigateCommand}" CommandParameter="Apply" />
    <KeyBinding Gesture="Cmd+5" Command="{Binding NavigateCommand}" CommandParameter="Quarantine" />
  </Window.KeyBindings>

  <Panel>

    <Grid RowDefinitions="Auto,*,Auto">

      <!-- ================================ TOP BAR ================================ -->
      <Border Background="{DynamicResource TopBarBrush}" Padding="20,12">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="40" Height="40" CornerRadius="{StaticResource RadiusLg}"
                    Background="{DynamicResource AccentBrush}">
              <Path Data="{StaticResource IconSprout}" Classes="icon"
                    Stroke="{DynamicResource TextOnAccentBrush}" Width="23" Height="23"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Spacing="0" VerticalAlignment="Center">
              <TextBlock Text="coppice" Classes="onDark" FontSize="20" FontWeight="Bold" />
              <TextBlock Text="Harvest what regrows. Never touch the root."
                         Classes="onDarkMuted" FontSize="12" />
            </StackPanel>
            <Border Classes="topChip" Margin="6,0,0,0">
              <TextBlock Text="v0.4 preview" Classes="onDarkMuted" FontSize="11" />
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <Border Classes="topChip" IsVisible="{Binding HasSnapshot}"
                    ToolTip.Tip="{Binding SnapshotId}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Border Classes="statusDot success" />
                <TextBlock Text="{Binding SnapshotLabel}" Classes="onDark" FontSize="12" />
              </StackPanel>
            </Border>
            <Button Classes="iconButton onDark"
                    Command="{Binding ToggleThemeCommand}"
                    ToolTip.Tip="Switch between light and dark"
                    AutomationProperties.Name="Switch between light and dark theme">
              <Panel>
                <Path Data="{StaticResource IconMoon}" Classes="icon sm"
                      Stroke="{DynamicResource TopBarTextBrush}" IsVisible="{Binding !IsDarkTheme}" />
                <Path Data="{StaticResource IconSun}" Classes="icon sm"
                      Stroke="{DynamicResource TopBarTextBrush}" IsVisible="{Binding IsDarkTheme}" />
              </Panel>
            </Button>
            <Button Classes="topBar"
                    Command="{Binding ToggleHelpCommand}"
                    AutomationProperties.Name="How Coppice works">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Path Data="{StaticResource IconHelp}" Classes="icon sm"
                      Stroke="{DynamicResource TopBarTextBrush}" />
                <TextBlock Text="How it works" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ================================= SHELL ================================= -->
      <Grid Grid.Row="1" ColumnDefinitions="284,*">

        <Border Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
          <Grid RowDefinitions="*,Auto" Margin="14,20,14,14">

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="20">

                <StackPanel Spacing="6">
                  <TextBlock Classes="metricLabel" Margin="10,0,0,4" Text="THE CLEANUP FLOW" />

                  <Button Classes="nav"
                          Classes.active="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=Setup}"
                          Command="{Binding NavigateCommand}" CommandParameter="Setup"
                          AutomationProperties.Name="Step 1, project roots">
                    <Grid ColumnDefinitions="Auto,*">
                      <Border Classes="stepBadge" Classes.done="{Binding IsSetupDone}">
                        <Panel>
                          <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     IsVisible="{Binding !IsSetupDone}" />
                          <Path Data="{StaticResource IconCheck}" Classes="icon" Width="13" Height="13"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding IsSetupDone}" />
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="10,2,0,0" Spacing="1">
                        <TextBlock Classes="navTitle" Text="Project roots" />
                        <TextBlock Classes="navDetail" Text="Where your code lives" />
                      </StackPanel>
                    </Grid>
                  </Button>

                  <Button Classes="nav"
                          Classes.active="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=Scan}"
                          Command="{Binding NavigateCommand}" CommandParameter="Scan"
                          AutomationProperties.Name="Step 2, scan">
                    <Grid ColumnDefinitions="Auto,*">
                      <Border Classes="stepBadge" Classes.done="{Binding IsScanDone}">
                        <Panel>
                          <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     IsVisible="{Binding !IsScanDone}" />
                          <Path Data="{StaticResource IconCheck}" Classes="icon" Width="13" Height="13"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding IsScanDone}" />
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="10,2,0,0" Spacing="1">
                        <TextBlock Classes="navTitle" Text="Scan" />
                        <TextBlock Classes="navDetail" Text="Read the cache, change nothing" />
                      </StackPanel>
                    </Grid>
                  </Button>

                  <Button Classes="nav"
                          Classes.active="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=Review}"
                          Command="{Binding NavigateCommand}" CommandParameter="Review"
                          ToolTip.Tip="Scan first to unlock the plan"
                          AutomationProperties.Name="Step 3, review plan">
                    <Grid ColumnDefinitions="Auto,*">
                      <Border Classes="stepBadge" Classes.done="{Binding IsReviewDone}">
                        <Panel>
                          <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     IsVisible="{Binding !IsReviewDone}" />
                          <Path Data="{StaticResource IconCheck}" Classes="icon" Width="13" Height="13"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding IsReviewDone}" />
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="10,2,0,0" Spacing="1">
                        <TextBlock Classes="navTitle" Text="Review plan" />
                        <TextBlock Classes="navDetail" Text="See the reason for every step" />
                      </StackPanel>
                    </Grid>
                  </Button>

                  <Button Classes="nav"
                          Classes.active="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=Apply}"
                          Command="{Binding NavigateCommand}" CommandParameter="Apply"
                          ToolTip.Tip="Review a plan to unlock apply"
                          AutomationProperties.Name="Step 4, apply">
                    <Grid ColumnDefinitions="Auto,*">
                      <Border Classes="stepBadge" Classes.done="{Binding IsApplyDone}">
                        <Panel>
                          <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     IsVisible="{Binding !IsApplyDone}" />
                          <Path Data="{StaticResource IconCheck}" Classes="icon" Width="13" Height="13"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding IsApplyDone}" />
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="10,2,0,0" Spacing="1">
                        <TextBlock Classes="navTitle" Text="Apply" />
                        <TextBlock Classes="navDetail" Text="Move approved items to quarantine" />
                      </StackPanel>
                    </Grid>
                  </Button>

                  <Button Classes="nav"
                          Classes.active="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=Quarantine}"
                          Command="{Binding NavigateCommand}" CommandParameter="Quarantine"
                          AutomationProperties.Name="Step 5, quarantine">
                    <Grid ColumnDefinitions="Auto,*">
                      <Border Classes="stepBadge">
                        <Panel>
                          <TextBlock Text="5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="10,2,0,0" Spacing="1">
                        <TextBlock Classes="navTitle" Text="Quarantine" />
                        <TextBlock Classes="navDetail" Text="{Binding QuarantineDetail}" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </StackPanel>

                <StackPanel Spacing="6">
                  <TextBlock Classes="metricLabel" Margin="10,0,0,4" Text="REFERENCE" />

                  <Button Classes="nav"
                          Classes.active="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=Items}"
                          Command="{Binding NavigateCommand}" CommandParameter="Items"
                          AutomationProperties.Name="Evidence, all items">
                    <Grid ColumnDefinitions="Auto,*">
                      <Path Data="{StaticResource IconList}" Classes="icon" Margin="4,3,0,0" />
                      <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="1">
                        <TextBlock Classes="navTitle" Text="Evidence" />
                        <TextBlock Classes="navDetail" Text="{Binding EvidenceDetail}" />
                      </StackPanel>
                    </Grid>
                  </Button>

                  <Button Classes="nav"
                          Classes.active="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=Roots}"
                          Command="{Binding NavigateCommand}" CommandParameter="Roots"
                          AutomationProperties.Name="Locations, where Coppice looks">
                    <Grid ColumnDefinitions="Auto,*">
                      <Path Data="{StaticResource IconMapPin}" Classes="icon" Margin="4,3,0,0" />
                      <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="1">
                        <TextBlock Classes="navTitle" Text="Locations" />
                        <TextBlock Classes="navDetail" Text="{Binding RootsDetail}" />
                      </StackPanel>
                    </Grid>
                  </Button>

                  <Button Classes="nav"
                          Classes.active="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=Problems}"
                          Command="{Binding NavigateCommand}" CommandParameter="Problems"
                          AutomationProperties.Name="Health findings">
                    <Grid ColumnDefinitions="Auto,*">
                      <Path Data="{StaticResource IconActivity}" Classes="icon" Margin="4,3,0,0" />
                      <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="1">
                        <TextBlock Classes="navTitle" Text="Health" />
                        <TextBlock Classes="navDetail" Text="{Binding ProblemsDetail}" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </StackPanel>

              </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="1" Classes="callout" Margin="0,16,0,0">
              <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Path Data="{StaticResource IconShieldCheck}" Classes="icon sm"
                        Stroke="{DynamicResource AccentSoftTextBrush}" />
                  <TextBlock Classes="label" Text="Safe by default" />
                </StackPanel>
                <TextBlock Classes="caption"
                           Text="Unknown usage is never proposed. Apply moves items into quarantine; nothing is deleted." />
              </StackPanel>
            </Border>

          </Grid>
        </Border>

        <Grid Grid.Column="1">
          <controls:PageHost Page="{Binding CurrentPage}" />

          <Border Background="{DynamicResource AppBackgroundBrush}"
                  IsVisible="{Binding IsInitializing}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="16" MaxWidth="380">
              <Border Width="54" Height="54" CornerRadius="{StaticResource RadiusXl}"
                      Background="{DynamicResource AccentBrush}" HorizontalAlignment="Center">
                <Path Data="{StaticResource IconSprout}" Classes="icon"
                      Stroke="{DynamicResource TextOnAccentBrush}" Width="30" Height="30"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Classes="sectionTitle" Text="Getting your workspace ready"
                         HorizontalAlignment="Center" />
              <TextBlock Classes="muted" TextAlignment="Center" Text="{Binding StartupStatus}" />
              <ProgressBar IsIndeterminate="True" Width="260" HorizontalAlignment="Center"
                           AutomationProperties.Name="Loading your last scan" />
              <TextBlock Classes="caption" TextAlignment="Center"
                         Text="This only reads your last scan. Nothing on your machine is changed." />
            </StackPanel>
          </Border>
        </Grid>

      </Grid>

      <!-- ================================= FOOTER ================================= -->
      <Border Grid.Row="2" Background="{DynamicResource SidebarBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
              Padding="20,9">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Classes="statusDot"
                    Classes.success="{Binding StatusTone, Converter={StaticResource Equals}, ConverterParameter=Success}"
                    Classes.warning="{Binding StatusTone, Converter={StaticResource Equals}, ConverterParameter=Warning}"
                    Classes.error="{Binding StatusTone, Converter={StaticResource Equals}, ConverterParameter=Error}" />
            <TextBlock Text="{Binding Status}" Classes="caption" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="Status" />
          </StackPanel>
          <TextBlock Grid.Column="1" Classes="caption" VerticalAlignment="Center"
                     Text="Runs locally · no telemetry" Margin="16,0,0,0" />
        </Grid>
      </Border>

    </Grid>

    <views:HelpOverlay IsVisible="{Binding IsHelpOpen}" />

  </Panel>
</Window>
