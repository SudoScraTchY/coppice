<?xml version="1.0" encoding="utf-8"?>
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================== TYPOGRAPHY ============================== -->

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
  </Style>

  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="LetterSpacing" Value="1" />
  </Style>

  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="{StaticResource FontSizePageTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="36" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.pageSubtitle">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxWidth" Value="760" />
  </Style>

  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="24" />
  </Style>

  <Style Selector="TextBlock.cardTitle">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="22" />
  </Style>

  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="LineHeight" Value="19" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.path">
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="TextBlock.metric">
    <Setter Property="FontSize" Value="{StaticResource FontSizeMetric}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="30" />
  </Style>

  <Style Selector="TextBlock.metricLabel">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="LetterSpacing" Value="0.6" />
  </Style>

  <Style Selector="TextBlock.pillText">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.strong">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.positive">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>

  <Style Selector="TextBlock.warningText">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>

  <Style Selector="TextBlock.dangerText">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <Style Selector="TextBlock.onDark">
    <Setter Property="Foreground" Value="{DynamicResource TopBarTextBrush}" />
  </Style>

  <Style Selector="TextBlock.onDarkMuted">
    <Setter Property="Foreground" Value="{DynamicResource TopBarMutedBrush}" />
  </Style>

  <!-- ================================ ICONS ================================= -->

  <Style Selector="Path.icon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="StrokeThickness" Value="1.7" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Path.icon.sm">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="StrokeThickness" Value="1.8" />
  </Style>

  <Style Selector="Path.icon.lg">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
  </Style>

  <Style Selector="Path.icon.xl">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="StrokeThickness" Value="1.5" />
  </Style>

  <Style Selector="Path.icon.mutedIcon">
    <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <Style Selector="Path.icon.accentIcon">
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Path.icon.onDarkIcon">
    <Setter Property="Stroke" Value="{DynamicResource TopBarTextBrush}" />
  </Style>

  <!-- ================================ SURFACES ============================== -->

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    <Setter Property="Padding" Value="{StaticResource CardPadding}" />
  </Style>

  <Style Selector="Border.card.muted">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="Border.card.compact">
    <Setter Property="Padding" Value="{StaticResource CardPaddingCompact}" />
  </Style>

  <Style Selector="Border.callout">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="14,12" />
  </Style>

  <Style Selector="Border.callout.warning">
    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
  </Style>

  <Style Selector="Border.callout.danger">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
  </Style>

  <Style Selector="Border.callout.info">
    <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}" />
  </Style>

  <Style Selector="Border.stat">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="14,12" />
  </Style>

  <Style Selector="Border.pill">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusFull}" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.pill.accent">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>

  <Style Selector="Border.pill.success">
    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
  </Style>

  <Style Selector="Border.pill.warning">
    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
  </Style>

  <Style Selector="Border.pill.danger">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
  </Style>

  <Style Selector="Border.pill.accent TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentSoftTextBrush}" />
  </Style>

  <Style Selector="Border.pill.success TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>

  <Style Selector="Border.pill.warning TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>

  <Style Selector="Border.pill.danger TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Border.pathBox">
    <Setter Property="Background" Value="{DynamicResource PathBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <Style Selector="Border.iconTile">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style Selector="Border.iconTile Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource AccentSoftTextBrush}" />
  </Style>

  <Style Selector="Border.topChip">
    <Setter Property="Background" Value="{DynamicResource TopBarChipBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TopBarChipBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusFull}" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.statusDot">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.statusDot.success">
    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
  </Style>

  <Style Selector="Border.statusDot.warning">
    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
  </Style>

  <Style Selector="Border.statusDot.error">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
  </Style>

  <!-- ================================ BUTTONS =============================== -->

  <Style Selector="Button">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.45" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.primary /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
  </Style>

  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
  </Style>

  <Style Selector="Button.primary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button.secondary /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.ghost /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavHoverBrush}" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.danger /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
  </Style>

  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.link /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.link:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
  </Style>

  <Style Selector="Button.iconButton">
    <Setter Property="Padding" Value="8" />
    <Setter Property="MinWidth" Value="36" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.iconButton /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.iconButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavHoverBrush}" />
  </Style>

  <Style Selector="Button.iconButton.onDark /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.iconButton.onDark:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TopBarChipBrush}" />
  </Style>

  <Style Selector="Button.topBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TopBarTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TopBarChipBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusFull}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinHeight" Value="32" />
  </Style>

  <Style Selector="Button.topBar /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TopBarChipBrush}" />
  </Style>

  <Style Selector="Button.topBar:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TopBarChipBorderBrush}" />
  </Style>

  <Style Selector="Button.topBar TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TopBarTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button:focus-visible /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- ============================== NAVIGATION ============================== -->

  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="MinHeight" Value="54" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.nav /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavHoverBrush}" />
  </Style>

  <Style Selector="Button.nav.active">
    <Setter Property="Background" Value="{DynamicResource NavActiveBrush}" />
  </Style>

  <Style Selector="Button.nav.active /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavActiveBrush}" />
  </Style>

  <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavActiveHoverBrush}" />
  </Style>

  <Style Selector="Button.nav.active TextBlock.navTitle">
    <Setter Property="Foreground" Value="{DynamicResource AccentSoftTextBrush}" />
  </Style>

  <Style Selector="Button.nav.active Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource AccentSoftTextBrush}" />
  </Style>

  <Style Selector="Button.nav TextBlock.navTitle">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="18" />
  </Style>

  <Style Selector="Button.nav TextBlock.navDetail">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="Border.stepBadge">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style Selector="Border.stepBadge TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <Style Selector="Button.nav.done Border.stepBadge">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="Button.nav.done Border.stepBadge Path">
    <Setter Property="Stroke" Value="{DynamicResource AccentSoftTextBrush}" />
  </Style>

  <Style Selector="Button.nav.active Border.stepBadge">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Button.nav.active Border.stepBadge TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
  </Style>

  <Style Selector="Button.nav.active Border.stepBadge Path">
    <Setter Property="Stroke" Value="{DynamicResource TextOnAccentBrush}" />
  </Style>

  <!-- ================================ INPUTS ================================ -->

  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentSoftBrush}" />
  </Style>

  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Height" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
  </Style>

  <Style Selector="Expander">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    <Setter Property="Padding" Value="16,12" />
  </Style>

  <!-- ================================= LISTS ================================ -->

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ListBox.rows ListBoxItem">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
  </Style>

  <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}" />
  </Style>

  <Style Selector="ListBox.policies /template/ ScrollViewer">
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <Style Selector="ListBox.policies ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="ListBox.policies ListBoxItem /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.policyCard">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <Style Selector="ListBox.policies ListBoxItem:pointerover Border.policyCard">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
  </Style>

  <Style Selector="ListBox.policies ListBoxItem:selected Border.policyCard">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="ListBox.policies ListBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentSoftTextBrush}" />
  </Style>

</Styles>
